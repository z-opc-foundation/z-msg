<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-msg 自包含 parent — 不依赖 monorepo 内部 parent,
        改造为 io.github.yuku123 namespace (Maven Central 命名空间).
        使用 ${revision} (CI-friendly versions) + flatten-maven-plugin 发版自动替换.

        模块结构:
          - z-msg-api          : 纯 SPI (MessageGateway/MessageBus/ChannelSender/RealtimePublisher/
                                 TopicAuthorizationPolicy/Channels), 零实现
          - z-msg-core         : 默认实现 (Mock/Smtp + SenderRegistry + ChannelRouter + RateLimiter
                                 + 模板 + 站内信 + ws-ticket 签发校验 + DDL)
          - z-msg-web          : Spring Boot Controller 层 + AutoConfiguration (spring.factories)
          - z-msg-ws           : WebSocket 实时接入 (短期 ticket 握手 + topic 三态授权 + 在线注册表)
          - z-msg-im           : 会话/成员/seq/已读回执, 实时下发只依赖 api 的 RealtimePublisher
          - z-msg-channels     : 真实外部渠道 provider (钉钉/企微/飞书/Slack/公众号/短信云厂商)
          - z-msg-example      : 五分钟聊天室 + 站内信 demo, 不发中央仓库
        注: z-msg-spring-boot-starter 已下沉到 z-boot/z-boot-middleware-starters
    -->
    <groupId>io.github.yuku123</groupId>
    <artifactId>z-msg</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>z-msg (Multi-Channel Message Delivery Aggregator)</name>
    <description>
        Z-MSG: 多通道消息下发抽象层（短信 / 邮件 / In-app / Push / Webhook / IM）。
        提供统一 MessageGateway SPI + 多 Provider 实现 + Spring Boot Controller 层 + AutoConfiguration。
        业务模块一行 import 即可发送多通道消息。
    </description>

    <url>https://github.com/z-opc-foundation/z-msg</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-msg.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/z-opc-foundation/z-msg.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-msg</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>z-msg-api</module>
        <module>z-msg-core</module>
        <module>z-msg-channels</module>
        <module>z-msg-ws</module>
        <module>z-msg-im</module>
        <module>z-msg-web</module>
        <module>z-msg-example</module>
    </modules>

    <properties>
        <!-- CI-friendly 版本根 (发版改这一处即可) -->
        <revision>1.1.0</revision>

        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 第三方版本 -->
        <spring-boot.version>2.7.12</spring-boot.version>
        <log4j2.version>2.20.0</log4j2.version>
        <slf4j.version>1.7.36</slf4j.version>

        <!-- 内部依赖 -->
        <z-boot.version>1.0.8</z-boot.version>
        <z-util.version>1.0.10</z-util.version>

        <!-- Maven 插件版本 -->
        <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
        <maven-enforcer-plugin.version>3.4.1</maven-enforcer-plugin.version>
        <central-publishing-maven-plugin.version>0.7.0</central-publishing-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Log4j2 BOM 必须排在 spring-boot-dependencies 之前：
                 多个 import BOM 冲突时 Maven 取"先声明者"，而 ${log4j2.version} 属性覆写
                 只对 parent 生效、对 import 进来的 BOM 无效。放在后面会导致
                 log4j-api/core/slf4j-impl 被 Boot 拉回 2.17.2，而 Boot 不认识的
                 log4j-slf4j2-impl 仍是 ${log4j2.version} —— 同一份 org.apache.logging.slf4j
                 包出现两个版本，启动即 NoSuchMethodError。 -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-bom</artifactId>
                <version>${log4j2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部 module -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-msg-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-msg-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-msg-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-msg-ws</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-msg-im</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-msg-channels</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- z-boot BOM -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-dependencies</artifactId>
                <version>${z-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- z-util -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-util-core</artifactId>
                <version>${z-util.version}</version>
                <exclusions>
                    <!-- z-util-core 自带 SLF4J 2.x 的绑定 log4j-slf4j2-impl；本工程栈是
                         Spring Boot 2.7 = slf4j-api 1.7.36，只能留 log4j-slf4j-impl。
                         两个 jar 共用 org.apache.logging.slf4j 包名，谁先上 classpath
                         谁赢，输的那个的 StaticLoggerBinder 会去 new 一个已被删掉的
                         无参构造器。 -->
                    <exclusion>
                        <groupId>org.apache.logging.log4j</groupId>
                        <artifactId>log4j-slf4j2-impl</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- 日志实现的唯一性靠人记"要排除 starter-logging"是记不住的：
                 1.0.x 就是因为漏排除，让 log4j-to-slf4j 和 log4j-slf4j-impl 同时上了 classpath。
                 这条规则把约束钉在构建上——新模块多引一个 starter 就会在 validate 阶段红，
                 而不是等到运行时 NoSuchMethodError / 日志成环。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>ban-competing-log-bindings</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <!-- 反向桥：和 log4j-slf4j-impl 同时在 classpath 上即成环 -->
                                        <exclude>org.apache.logging.log4j:log4j-to-slf4j</exclude>
                                        <!-- SLF4J 2.x 绑定：与 1.7.36 的栈不同代，共用同一个 java 包 -->
                                        <exclude>org.apache.logging.log4j:log4j-slf4j2-impl</exclude>
                                        <!-- Boot 默认日志实现，本工程一律换 Log4j2 -->
                                        <exclude>org.springframework.boot:spring-boot-starter-logging</exclude>
                                        <exclude>ch.qos.logback:*</exclude>
                                        <exclude>org.slf4j:slf4j-log4j12</exclude>
                                        <exclude>org.slf4j:slf4j-simple</exclude>
                                    </excludes>
                                    <message>z-msg 只允许 Log4j2 + slf4j 1.7 一条绑定链，见 pom 顶部的日志说明</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <!-- oss 模式: 子 POM 完全 self-contained,
                         自定义 ${xxx} 属性也会解析, url/licenses/developers/scm 元数据保留.
                         详见 lead/005_技术架构/004_flatten_maven_plugin_模式选择.md -->
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>central</id>
            <properties>
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                                <arg>--no-tty</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <waitUntil>uploaded</waitUntil>
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>