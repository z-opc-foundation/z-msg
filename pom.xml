<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-msg 对外发布仍是自包含 pom（下面 flatten oss 会把 parent 剥掉），
        但**构建口径**统一挂到 io.github.yuku123:z-boot-parent 上（见 <parent> 那段的注释）——
        不再依赖 monorepo 内部 parent，也不再自己养版本属性表。
        使用 ${revision} (CI-friendly versions) + flatten-maven-plugin 发版自动替换.

        模块结构:
          - z-msg-api          : 纯 SPI (MessageGateway/MessageBus/ChannelSender/RealtimePublisher/
                                 TopicAuthorizationPolicy/Channels), 零实现
          - z-msg-core         : 默认实现 (Mock/Smtp + SenderRegistry + ChannelRouter + RateLimiter
                                 + 模板 + 站内信 + ws-ticket 签发校验 + DDL)
          - z-msg-web          : Spring Boot Controller 层 + AutoConfiguration (spring.factories)
          - z-msg-ws           : WebSocket 实时接入 (短期 ticket 握手 + topic 三态授权 + 在线注册表)
          - z-msg-im           : 会话/成员/seq/已读回执, 实时下发只依赖 api 的 RealtimePublisher
          - z-msg-channels     : 真实外部渠道 provider (钉钉/企微/飞书/Slack/公众号/短信云厂商)
          - z-msg-example      : 五分钟聊天室 + 站内信 demo, 不发中央仓库
        注: z-msg-spring-boot-starter 已下沉到 z-boot/z-boot-middleware-starters
    -->
    <!-- 消费入口统一走 z-boot-parent（1.0.19 起全组织口径，试点是 z-cache）：一行 parent 白拿
         第三方地板 z-boot-dependencies:1.0.19（156 条）+ 兄弟仓版本权威 z-boot-fleet:1.0.0（163 条）
         + Java 8 的 pluginManagement。迁移前本仓**没有 parent**，自家 <properties> 里养着
         spring-boot.version / log4j2.version / slf4j.version / z-boot.version / z-util.version
         五格版本表，另外每个模块再 import 一次 z-boot-dependencies 当 BOM 用（core/web 还把那条
         import 写在 <dependencies> 而不是 <dependencyManagement> 里 —— 那里 scope=import 是空转的）。
         relativePath 必须留空：parent 不在磁盘上，在 repo1。 -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-parent</artifactId>
        <version>1.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-msg</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>z-msg (Multi-Channel Message Delivery Aggregator)</name>
    <description>
        Z-MSG: 多通道消息下发抽象层（短信 / 邮件 / In-app / Push / Webhook / IM）。
        提供统一 MessageGateway SPI + 多 Provider 实现 + Spring Boot Controller 层 + AutoConfiguration。
        业务模块一行 import 即可发送多通道消息。
    </description>

    <url>https://github.com/z-opc-foundation/z-msg</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-msg.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/z-opc-foundation/z-msg.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-msg</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>z-msg-api</module>
        <module>z-msg-core</module>
        <module>z-msg-channels</module>
        <module>z-msg-ws</module>
        <module>z-msg-im</module>
        <module>z-msg-web</module>
        <module>z-msg-example</module>
    </modules>

    <properties>
        <!-- CI-friendly 版本根 (发版改这一处即可) -->
        <revision>1.2.2</revision>

        <!-- 版本口径全部由 parent 下发。2026-09-29 迁移删掉的键逐条按**坐标**对过
             （parent_preflight.py 对 z-msg 报的第 2/5 节）：
               maven.compiler.source/target=8、project.build.sourceEncoding=UTF-8
                   → 父链面值逐字相同（z-boot-parent/pom.xml:56-58 就是 8 / 8 / UTF-8）；
               spring-boot.version=2.7.18
                   → 父链同值（z-boot-parent/pom.xml:66），且地板 import spring-boot-dependencies
                     时用的就是这一格；
               flatten-maven-plugin.version=1.7.3
                   → 父链同值。键删了但插件声明里的 <version> 引用点留着：parent 那条 flatten 是
                     <inherited>false</inherited>（z-boot-parent/pom.xml:261），不下发插件声明，
                     本仓必须自己常开 flatten（发布形状见下面 build 段的注释）；
               z-util.version=1.0.13
                   → 键名父链没有，但 fleet 按坐标管着 z-util-core/-aop/-dsl/-parser-json，
                     面值同为 1.0.13 ⇒ 该删（README 陷阱 3：判"供不供"按坐标不按键名）；
               z-boot.version=1.0.17
                   → parent 按坐标供 z-boot-web-starter / z-boot-datasource-starter 1.0.19
                     （z-boot 自家 starter 只能和 z-boot 同版本发行），留 1.0.17 就是"各仓再钉一遍"
                     的旧账 —— 这一格是刻意跟随，实测 tree 里两行 1.0.17→1.0.19，两版都带
                     spring-boot-starter-log4j2 2.7.18（repo1 回读两侧 pom 逐字对过），实现没换味；
               slf4j.version=1.7.36
                   → 全仓 8 个 pom 现读 **0 处引用**（连注释都没写过它），是个纯死键；slf4j-api 的
                     面值本来由地板 import 的 spring-boot-dependencies 给（两侧同为 1.7.36，
                     tree 一行没动）。删。

             必须留着的两类：
               log4j2.version=2.20.0 —— 与地板**不同值**（地板 2.25.4），是刻意的零漂移选择，
                   删掉就是悄悄把本仓的日志实现换成另一版；见下面 DM 那四条直接条目。
               maven-enforcer-plugin.version=3.4.1、central-publishing-maven-plugin.version=0.7.0
                   —— 父链的 pluginManagement 只管 compiler/surefire/failsafe/jar/resources/
                     spring-boot 六件，这两件父链不供，删键当场悬空。 -->
        <log4j2.version>2.20.0</log4j2.version>
        <maven-enforcer-plugin.version>3.4.1</maven-enforcer-plugin.version>
        <central-publishing-maven-plugin.version>0.7.0</central-publishing-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 自家 8 个 reactor 坐标钉 ${project.version}（z-boot README「消费模型」步骤 4）。
                 这一格不是装饰：继承来的 DM 会改写**传递依赖**的版本，而 fleet 里 z-msg 那一格
                 （`z-msg.version`=1.2.1，现读 z-boot-fleet/pom.xml:46）钉的是 repo1 上的**已发布件**
                 ⇒ 下次抬 revision 时，不补这 8 条就会把 1.2.1 的字节码经传递依赖打进 1.2.2 的包里。
                 本仓当前 revision 与 fleet 面值同为 1.2.1，所以补完这一批 tree 一行没动。
                 z-msg-example 也在清单里，但它被 central profile 的 excludeArtifacts 挡在 Central 外、
                 fleet 里没有这一格（gen_fleet_bom.py 的 SKIP_ARTIFACTS），写它只为让"自家坐标一律
                 ${project.version}"这一条不再有例外。 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-msg</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-msg-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-msg-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-msg-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-msg-ws</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-msg-im</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-msg-channels</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-msg-example</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Log4j2 BOM 必须排在其它 import 之前（多 BOM 冲突时 Maven 取先声明者）——
                 这一句在迁移**前**是关键，迁移**后**只剩说明作用：本仓不再 import
                 spring-boot-dependencies（地板 1.0.19 已经 import 了同一坐标同一格 2.7.18），
                 而 log4j2 这一族真正压住版本的是下面四条**直接**条目，不是这条 import。
                 原因见 README 陷阱 5：`<scope>import</scope>` 进来的 BOM 顶不过从 parent
                 继承来的直接 DM 条目，而地板把 log4j-api / -core / -jul / -slf4j-impl 四条
                 直接钉在 2.25.4（z-boot-dependencies/pom.xml:517-535）⇒ 只留 import 的话
                 实测这 4 件全漂到 2.25.4。import 留着是为了管住地板没逐条钉的 log4j 成员
                 （log4j-1.2-api / log4j-web / …），直接条目负责本仓 tree 里真实出现的那 4 个。 -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-bom</artifactId>
                <version>${log4j2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-jul</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-slf4j-impl</artifactId>
                <version>${log4j2.version}</version>
            </dependency>

            <!-- 迁移删掉的条目（逐条对过 preflight 第 2/5 节，判"供不供"按坐标不按键名）：
                 1) org.springframework.boot:spring-boot-dependencies:${spring-boot.version} 的 import
                    —— 地板 1.0.19 自己 import 同一坐标同一格 2.7.18；本仓再 import 一份只会和
                    地板 import 的 spring-framework-bom 5.3.39 / netty-bom 4.1.138.Final 抢 dm 优先级。
                 2) io.github.yuku123:z-boot-dependencies（原键 z-boot.version=1.0.17）的 import
                    —— parent 的 parent 就是这一坐标（1.0.19）。留 1.0.17 的 import 顶不住继承来的
                    直接条目（README 陷阱 5），只会造成 dm 打架；地板抬一格是本迁移的目的本身。
                 3) io.github.yuku123:z-util-core（原键 z-util.version=1.0.13）
                    —— fleet 按同一坐标供 1.0.13，同值 ⇒ 整条删掉。
                    ⚠ 这条原来的真正作用不是版本、是它身上那条 `log4j-slf4j2-impl` 的 exclusion
                    （z-util-core:1.0.13 的发布 pom 确实带 SLF4J 2.x 那支绑定，repo1 回读命中；
                    它和本仓用的 log4j-slf4j-impl 共用 org.apache.logging.slf4j 包名，同时在类路径上
                    就是 NoSuchMethodError，而本仓的 enforcer 规则也直接把它 ban 掉）。
                    exclusion 是实现选择不是版本，所以它跟着 z-util-core 的**声明点**走：
                    已逐模块写进 core/channels/web/ws/im 的 `<exclusions>`（写法照 z-kb-core/pom.xml:63-75）。
                    这样写还有个好处：transitive 的 z-util-core 只可能来自这四个模块的声明点
                    （repo1 回读 z-boot-web-starter / z-boot-datasource-starter / z-boot-base 的
                    1.0.17 与 1.0.19 四份 pom，z-util 引用计数均为 0），不存在漏排的路径。 -->
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- 日志实现的唯一性靠人记"要排除 starter-logging"是记不住的：
                 1.0.x 就是因为漏排除，让 log4j-to-slf4j 和 log4j-slf4j-impl 同时上了 classpath。
                 这条规则把约束钉在构建上——新模块多引一个 starter 就会在 validate 阶段红，
                 而不是等到运行时 NoSuchMethodError / 日志成环。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>ban-competing-log-bindings</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <!-- 反向桥：和 log4j-slf4j-impl 同时在 classpath 上即成环 -->
                                        <exclude>org.apache.logging.log4j:log4j-to-slf4j</exclude>
                                        <!-- SLF4J 2.x 绑定：与 1.7.36 的栈不同代，共用同一个 java 包 -->
                                        <exclude>org.apache.logging.log4j:log4j-slf4j2-impl</exclude>
                                        <!-- Boot 默认日志实现，本工程一律换 Log4j2 -->
                                        <exclude>org.springframework.boot:spring-boot-starter-logging</exclude>
                                        <exclude>ch.qos.logback:*</exclude>
                                        <exclude>org.slf4j:slf4j-log4j12</exclude>
                                        <exclude>org.slf4j:slf4j-simple</exclude>
                                    </excludes>
                                    <message>z-msg 只允许 Log4j2 + slf4j 1.7 一条绑定链，见 pom 顶部的日志说明</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <!-- 键已删，引用点留着：${flatten-maven-plugin.version}=1.7.3 现在由 parent 的
                     properties 供（z-boot-parent/pom.xml:70，与本仓迁移前逐字相同）。
                     写成空 <version> 也能解析到 parent 的 pluginManagement，但本仓的发布形状
                     要求这条声明**常开**（不挂 central profile）：z-boot-parent 那条 flatten 是
                     <inherited>false</inherited>（z-boot-parent/pom.xml:255-266，它自己用
                     resolveCiFriendliesOnly），不会把 flatten 下发给消费仓 ⇒ 一旦本仓不声明，
                     加了 <parent> 之后发出去的 pom 就会带着 z-boot-parent:1.0.19 出厂，
                     而本仓中央上现在是自包含 raw pom（repo1 回读 z-msg/z-msg-api/…/z-msg-channels
                     1.2.1 七份，`<parent>` 计数全为 0、com.zifang 计数 0），形状不能被我这一刀改掉。
                     central_pom_scan 的 E 类也只看本仓 pom 链、不跟外部 parent 走 ⇒ 显式写一行。 -->
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <!-- oss 模式: 子 POM 完全 self-contained,
                         自定义 ${xxx} 属性也会解析, url/licenses/developers/scm 元数据保留.
                         详见 lead/005_技术架构/004_flatten_maven_plugin_模式选择.md -->
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- 同上：3.11.0 这一格 parent 的 pluginManagement 与本仓迁移前逐字相同，
                     键住在父链里（z-boot-parent/pom.xml:61），这里留一行引用点让尺子保持绿。
                     ⚠ parent 那份 <configuration> 的 <compilerArgs>-parameters</compilerArgs> 是
                     **合并**进来的、挡不住（z-gw/z-config 试点都实测过：class 的 MethodParameters
                     属性会变，major 仍是 52）。换 Spring 构造器注入的参数名口径不在这一刀里。 -->
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>central</id>
            <properties>
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                                <arg>--no-tty</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- 示例宿主不是构件，是拿来跑的；发出去只会让 io.github.yuku123
                                 多一个 demo 坐标。1.1.0 首次发布漏了这条，
                                 z-msg-example:1.1.0 已经在中央仓库里（bundle 内 24 个文件），
                                 版本号不可复用 ⇒ 删不掉，只能从下一版起排除。
                                 为什么不用模块里的 skipPublishing：见 z-msg-example/pom.xml 注释。 -->
                            <excludeArtifacts>
                                <excludeArtifact>z-msg-example</excludeArtifact>
                            </excludeArtifacts>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <waitUntil>uploaded</waitUntil>
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>