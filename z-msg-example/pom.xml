<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ${revision} ONLY inside <parent>.version, NOT at project level -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-msg</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>z-msg-example</artifactId>
    <packaging>jar</packaging>
    <name>z-msg-example (5 分钟聊天室 + 站内信 demo，不发中央仓库)</name>
    <description>
        一个可直接 mvn spring-boot:run 的宿主应用：演示 WebSocket 接入、聊天室、微信式单聊/群聊、
        站内信实时红点、外部渠道 fan-out。同时承载整条链路的端到端测试。
    </description>

    <properties>
        <!-- 示例工程不参与发布。注意这条【不是】靠它做到的：
             central-publishing-maven-plugin 0.7.0 读自己的 skipPublishing/excludeArtifacts，
             不看 maven.deploy.skip —— 1.1.0 那次实测 z-msg-example 照样进了 bundle
             （zip 里 24 个 z-msg-example 文件）。真正生效的配置在根 pom central profile 的
             <excludeArtifacts> 里。留着这条只为止住普通 maven-deploy-plugin 往别的仓库发。
             这里原先还有一条 <gpg.skip>true</gpg.skip>：central profile 的 gpg 插件写的是
             <skip>${central.gpg.skip}</skip>，把 gpg 插件默认的 ${gpg.skip} 顶掉了，所以那行是死配置。 -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-msg-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-msg-ws</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-msg-im</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-msg-channels</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <!-- 示例是这堆模块里唯一会真正 assemble 成 runnable 应用的地方：
                     starter-logging 的 log4j-to-slf4j 一旦和 log4j-slf4j-impl 同时上桌，
                     slf4j→log4j2→slf4j 就地成环 -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <!-- ============ test ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.zifang.z.msg.example.MsgExampleApplication</mainClass>
                    <!-- 这里原先还有一条 <skip>true</skip>：它确实挡住了 fat jar，
                         但也一起挡住了本模块唯一的用途 spring-boot:run —— skip 是插件级
                         configuration，AbstractRunMojo 同样读它。不产 fat jar 靠的是本模块
                         没给 repackage 绑 execution，不是靠这个 skip。 -->
                </configuration>
            </plugin>
            <!-- "示例不进中央仓库"的实现位置在根 pom 的 central profile：
                 <excludeArtifacts>z-msg-example</excludeArtifacts>。
                 不要在这里写 skipPublishing —— 本模块是 reactor 最后一个，而 central-publishing
                 0.7.0 的 bundle 创建与上传都发生在"最后一次 publish 执行"里：
                 实测（dryrun 把 centralBaseUrl 指向本机空端口）写了 skipPublishing 之后
                 bundle 照样打包（z-msg-example 的 24 个文件还在 zip 里），
                 上传却整场被跳过 ⇒ 七个该发的构件一个都发不出去。 -->
        </plugins>
    </build>

</project>
