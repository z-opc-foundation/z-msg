    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-msg</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>z-msg-api</artifactId>
    <packaging>jar</packaging>
    <name>z-msg-api (Multi-Channel Message SPI, zero impl)</name>
    <description>
        Z-MSG API 层: 纯 SPI 接口定义（MessageGateway / MessageBus / EmailSender / SmsSender /
        MessageEvent / Channels / MessageException），零实现，无 Spring 框架依赖。
        任何业务模块 / 第三方框架都可引用本模块扩展自己的 Provider。
    </description>

    <url>https://github.com/z-opc-foundation/z-msg/tree/main/z-msg-api</url>
