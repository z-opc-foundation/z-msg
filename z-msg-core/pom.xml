<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ${revision} ONLY inside <parent>.version, NOT at project level -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-msg</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>z-msg-core</artifactId>
    <packaging>jar</packaging>
    <name>z-msg-core (Default Message Providers + Router + RateLimiter + 7 DO entities)</name>
    <description>
        Z-MSG Core 层: 默认 Provider 实现（Mock/Smtp Email + Mock Sms）+ ChannelRouter + RateLimiter
        + MessageTemplateEngine + 7 DO 实体（MsgTemplate / MsgTemplateVersion / MsgTemplateI18n /
        MsgBatchTask / MsgDeliveryLog / MsgUserPreference / InAppMessage）。
        生产可替换为 Aliyun SMS / Tencent Cloud SMS 等真实 Provider。
    </description>

    <url>https://github.com/z-opc-foundation/z-msg/tree/main/z-msg-core</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-msg.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/z-opc-foundation/z-msg.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-msg</url>
        <tag>HEAD</tag>
    </scm>

    <dependencies>
        <!-- 内部 module: z-msg-api SPI（版本由父 dependencyManagement 锁） -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-msg-api</artifactId>
        </dependency>

        <!-- 内部工具：版本由 fleet 按坐标下发（z-util-core 1.0.13，与本模块迁移前 z-util.version
             面值逐字相同）。下面那条 log4j-slf4j2-impl 的 exclusion **保留** —— 它是实现选择不是版本：
             z-util-core:1.0.13 的发布 pom 自带 SLF4J 2.x 绑定，而本工程栈是 Spring Boot 2.7 =
             slf4j-api 1.7.36 + log4j-slf4j-impl，两支共用 org.apache.logging.slf4j 包名，
             同时在类路径上就是 NoSuchMethodError（enforcer 的 ban 规则也盯着它）。
             迁移前这条 exclusion 挂在仓根 DM 的 z-util-core 条目上；那条 DM 已随版本键一起删，
             所以 exclusion 跟着声明点走（写法照 z-kb-core/pom.xml）。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- z-boot starter：版本由 parent 按坐标下发（1.0.19，原 z-boot.version=1.0.17）。
             这里原先还有一条 z-boot-dependencies 的 `<type>pom</type><scope>import</scope>`，
             而且它写在 <dependencies> 而不是 <dependencyManagement> 里 —— import 作用域在
             <dependencies> 上是空转的（Maven 只认 DM 里的 import），地板现在由 parent 直接继承，
             删掉。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-datasource-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-web-starter</artifactId>
            <exclusions>
                <!-- 2026-10-04: 这条路径以前没排过，父链从 1.0.19 抬到 1.0.21 之后
                     z-boot-web-starter 自己带了一条 log4j-slf4j2-impl(2.25.4)，
                     于是 ban-competing-log-bindings 在 z-msg-core 上第一次报红（enforcer 原文）：
                         io.github.yuku123:z-msg-core:jar:1.2.2
                            io.github.yuku123:z-boot-web-starter:jar:1.0.21
                               org.apache.logging.log4j:log4j-slf4j2-impl:jar:2.25.4 [banned]
                     与上面 z-util-core 那条是同一件事的第二个入口：SLF4J 2.x 绑定与本工程栈
                     (log4j-slf4j-impl + slf4j-api 1.7.36) 共用 org.apache.logging.slf4j 包名，
                     同时在类路径上就是 NoSuchMethodError。两个入口都要排，只排一个等于没排。 -->
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- FEATURE011: 真实邮件发送 (SmtpEmailSender 用 JavaMailSender) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
            <exclusions>
                <!-- 本工程只用 Log4j2：core 是被宿主继承的库，漏进 logback 会让宿主日志实现二义 -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Log4j2 API (本模块 src/main/java 含 LogManager.getLogger 调用) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <!-- ============ test ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- schema-h2.sql 与 MySQL 版同源性由测试真实执行验证，需要真 H2 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>